# File types to exclude
*.md
*.pdf
*.csv
*.xlsx
*.txt
*.sh

# Large log files
import_optimized.log
import_full.log
import.log

# Laravel specific
/vendor/
/node_modules/
/public/hot
/public/storage
/storage/*.key
/storage/app/public/*
!/storage/app/public/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/testing/*
!/storage/framework/testing/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep

# Environment files
.env
.env.backup
.env.production

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build files
/public/build/
/public/mix-manifest.json

# Test files
/coverage/
.phpunit.result.cache
backup_before_reset.sql
backup_*.sql

# Env backup (keep .env out of repo)
.env.backup.*

# Script one-off / test (non parte del deploy)
/check_*.php
/check_*.sql
/test_*.php
/test-*.php
/analyze_cards.php
/count_cards.php
/delete_and_reimport.php
/fix_*.sql
/update_rarities*.php
/public/test-*.html

# Cartella mockup/design (asset già copiati in public/images/hero e public/images/come-funziona)
/immagini sito (hero - come funziona)/

# File accidentalmente creati in root (echo/typo)
/LeBron
/Lionel
/Pokemon
/Football
/Football*
/Pokemon*
